# Configure these as Edge Function secrets in your Supabase project.
COURSESTUDIO_OWNER_EMAIL=administrator@example.edu
COURSESTUDIO_ALLOWED_ORIGINS=https://YOUR-GITHUB-USERNAME.github.io
